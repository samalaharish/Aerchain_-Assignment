# Production demo AI/provider settings.
EXTRACTION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_RFX_MODEL=gpt-4o-mini
OPENAI_ANALYST_MODEL=gpt-4o-mini
ANALYST_PROVIDER=openai
ENABLE_AI_CACHE=true
AI_BUDGET_USD=2.00
MAX_UPLOAD_MB=10
FX_BASE_CURRENCY=INR
