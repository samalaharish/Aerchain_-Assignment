# Public browser-safe Supabase values for later goals.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Do not expose these in client components.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Defaults to a deterministic demo provider so the prototype runs without external AI credentials.
EXTRACTION_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_RFX_MODEL=gpt-4o-mini
OPENAI_ANALYST_MODEL=gpt-4o-mini
ANALYST_PROVIDER=deterministic
ENABLE_AI_CACHE=true
AI_BUDGET_USD=2.00
MAX_UPLOAD_MB=10
FX_BASE_CURRENCY=INR
